{
    "name": "@open-pioneer/changesets-release-line",
    "version": "0.1.3",
    "description": "This package provides a custom release line for @changesets/cli to be used in official Open Pioneer Trails repositories.",
    "keywords": [
        "open-pioneer-trails"
    ],
    "homepage": "https://github.com/open-pioneer",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/open-pioneer/trails-build-tools.git",
        "directory": "packages/changesets-release-line"
    },
    "files": [
        "dist",
        "CHANGELOG.md",
        "README.md",
        "LICENSE"
    ],
    "type": "module",
    "exports": {
        ".": "./dist/index.js",
        "./package.json": "./package.json"
    },
    "scripts": {
        "clean": "rimraf dist",
        "build": "tsdown",
        "dev": "tsdown --watch"
    },
    "devDependencies": {
        "@changesets/cli": "catalog:",
        "publint": "catalog:",
        "shared-configs": "workspace:*",
        "tsdown": "catalog:"
    },
    "engines": {
        "node": ">= 20"
    }
}
