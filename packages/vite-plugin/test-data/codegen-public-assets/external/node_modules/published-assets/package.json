{
    "type": "module",
    "name": "published-assets",
    "version": "1.0.0",
    "dependencies": {
        "cdn-lib": "^1.0.0"
    },
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "import": "./index.js"
        }
    },
    "openPioneerFramework": {
        "packageFormatVersion": "1.2.0",
        "publicAssets": [
            { "type": "local", "src": "public", "dest": "" },
            { "type": "dependency", "packageName": "cdn-lib", "src": "cdn", "dest": "cdn" }
        ]
    }
}
