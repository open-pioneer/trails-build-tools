        "zod": "catalog:",
        "zod-validation-error": "catalog:"
    },
    "devDependencies": {
        "@open-pioneer/build-support": "workspace:^",
        "@open-pioneer/runtime": ">= 4.0.0",
        "@open-pioneer/vite-plugin-pioneer": "workspace:^",
        "@types/babel__generator": "catalog:",
        "@types/babel__template": "catalog:",
        "@types/debug": "catalog:",
        "@types/js-yaml": "catalog:",
        "publint": "catalog:",
        "rimraf": "catalog:",
        "rolldown": "catalog:",
