{
    "name": "@open-pioneer/build-support",
    "version": "3.1.3",
    "description": "Contains support functionality used in Open Pioneer Trails applications.",
    "keywords": [
        "open-pioneer-trails"
    ],
    "homepage": "https://github.com/open-pioneer",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/open-pioneer/trails-build-tools.git",
        "directory": "packages/build-support"
    },
    "files": [
        "dist",
        "CHANGELOG.md",
        "README.md",
        "LICENSE"
    ],
    "type": "module",
    "exports": {
        ".": "./dist/index.js",
        "./package.json": "./package.json"
    },
    "scripts": {
        "clean": "rimraf dist",
        "build": "tsdown",
        "dev": "tsdown --watch"
    },
    "devDependencies": {
        "publint": "catalog:",
        "shared-configs": "workspace:*",
        "tsdown": "catalog:",
        "typescript": "catalog:"
    },
    "engines": {
        "node": ">= 20"
    }
}
