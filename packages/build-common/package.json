{
    "name": "@open-pioneer/build-common",
    "version": "4.0.3",
    "description": "Common functionality used when building Open Pioneer Trails applications or packages.",
    "keywords": [
        "open-pioneer-trails"
    ],
    "homepage": "https://github.com/open-pioneer",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/open-pioneer/trails-build-tools.git",
        "directory": "packages/build-common"
    },
    "files": [
        "dist",
        "CHANGELOG.md",
        "README.md",
        "LICENSE"
    ],
    "type": "module",
    "exports": {
        ".": "./dist/index.js",
        "./package.json": "./package.json"
    },
    "scripts": {
        "clean": "rimraf dist temp",
        "build": "tsdown",
        "dev": "tsdown --watch",
        "test": "vitest"
    },
    "dependencies": {
        "@open-pioneer/build-support": "workspace:^",
        "@rollup/pluginutils": "catalog:",
        "semver": "catalog:",
        "zod": "catalog:",
        "zod-validation-error": "catalog:"
    },
    "devDependencies": {
        "@types/semver": "catalog:",
        "publint": "catalog:",
        "shared-configs": "workspace:*",
        "tsdown": "catalog:",
        "typescript": "catalog:"
    },
    "engines": {
        "node": ">= 20"
    }
}
