{
    "name": "@open-pioneer/create-license-cli",
    "version": "0.0.1",
    "description": "Implements creation of Open Pioneer Trails license file.",
    "keywords": [
        "open-pioneer-trails"
    ],
    "homepage": "https://github.com/open-pioneer",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/open-pioneer/trails-build-tools.git",
        "directory": "packages/build-license"
    },
    "bin": {
        "create-license-report": "./dist/index.js"
    },
    "files": [
        "dist",
        "CHANGELOG.md",
        "README.md",
        "LICENSE"
    ],
    "type": "module",
    "scripts": {
        "clean": "rimraf dist temp",
        "test": "vitest",
        "build": "tsdown",
        "dev": "tsdown --watch"
    },
    "dependencies": {
        "@open-pioneer/cli-logging": "workspace:^",
        "commander": "catalog:",
        "js-yaml": "catalog:",
        "spdx-expression-parse": "catalog:",
        "spdx-satisfies": "catalog:",
        "tinyglobby": "catalog:",
        "zod": "catalog:",
        "zx": "catalog:"
    },
    "devDependencies": {
        "@types/js-yaml": "catalog:",
        "@types/spdx-expression-parse": "catalog:",
        "@types/spdx-satisfies": "catalog:",
        "build-tools": "workspace:*",
        "publint": "catalog:",
        "shared-configs": "workspace:*",
        "tsdown": "catalog:"
    },
    "engines": {
        "node": ">= 20"
    }
}
