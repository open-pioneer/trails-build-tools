{
    "name": "@open-pioneer/build-package",
    "version": "4.3.2",
    "description": "Implements partial compilation for Open Pioneer Trails packages.",
    "keywords": [
        "open-pioneer-trails"
    ],
    "homepage": "https://github.com/open-pioneer",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/open-pioneer/trails-build-tools.git",
        "directory": "packages/build-package"
    },
    "files": [
        "dist",
        "CHANGELOG.md",
        "README.md",
        "LICENSE"
    ],
    "type": "module",
    "exports": {
        ".": "./dist/index.js",
        "./package.json": "./package.json"
    },
    "scripts": {
        "clean": "rimraf dist temp",
        "build": "tsdown",
        "dev": "tsdown --watch",
        "test": "vitest"
    },
    "dependencies": {
        "@open-pioneer/build-common": "workspace:^",
        "@open-pioneer/build-support": "workspace:^",
        "@rollup/plugin-node-resolve": "catalog:",
        "@rollup/pluginutils": "catalog:",
        "chalk": "catalog:",
        "debug": "catalog:",
        "esbuild": "catalog:",
        "find-git-root": "catalog:",
        "find-workspaces": "catalog:",
        "fs-extra": "catalog:",
        "import-meta-resolve": "catalog:",
        "postcss": "catalog:",
        "postcss-import": "catalog:",
        "rollup": "catalog:",
        "rollup-plugin-esbuild": "catalog:",
        "tinyglobby": "catalog:"
    },
    "devDependencies": {
        "@types/debug": "catalog:",
        "@types/fs-extra": "catalog:",
        "@types/postcss-import": "catalog:",
        "@types/react": "catalog:",
        "publint": "catalog:",
        "sass": "catalog:",
        "shared-configs": "workspace:*",
        "tsdown": "catalog:",
        "typescript": "catalog:"
    },
    "peerDependencies": {
        "sass": "*",
        "typescript": "*"
    },
    "peerDependenciesMeta": {
        "typescript": {
            "optional": true
        },
        "sass": {
            "optional": true
        }
    },
    "engines": {
        "node": ">= 20"
    }
}
