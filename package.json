{
    "name": "build-tools",
    "version": "0.0.1",
    "private": true,
    "license": "Apache-2.0",
    "type": "module",
    "scripts": {
        "clean": "pnpm recursive --no-sort run clean",
        "dev": "pnpm run --parallel --if-present dev",
        "build": "pnpm recursive --sort run build",
        "test": "vitest",
        "check-types": "tsc --noEmit",
        "watch-types": "pnpm check-types -w",
        "check-generated": "node support/checkGenerated.js",
        "lint": "oxlint .",
        "lint:fix": "oxlint . --fix",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "prepare": "husky",
        "ci:test": "pnpm run clean && pnpm run build && pnpm run check-generated && pnpm run check-types && pnpm run lint && pnpm install && pnpm run test run",
        "ci:version": "pnpm changeset version && pnpm exec oxfmt && pnpm install",
        "ci:publish": "pnpm run clean && pnpm run build && pnpm publish -r --access public && pnpm changeset tag"
    },
    "devDependencies": {
        "@changesets/cli": "catalog:",
        "@tony.ganchev/eslint-plugin-header": "catalog:",
        "@types/node": "catalog:",
        "husky": "catalog:",
        "lint-staged": "catalog:",
        "oxfmt": "catalog:",
        "oxlint": "catalog:",
        "rimraf": "catalog:",
        "typescript": "catalog:",
        "vite": "catalog:",
        "vitest": "catalog:"
    },
    "engines": {
        "node": ">= 24",
        "pnpm": ">= 10"
    },
    "packageManager": "pnpm@11.25.0"
}
